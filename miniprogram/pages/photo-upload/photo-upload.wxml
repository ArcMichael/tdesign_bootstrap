<navigation-bar back="{{true}}" color="black"></navigation-bar>

<view class="page-wrapper register">
  <view class="processing-group">
    <view class="processing reading"></view>
    <view class="processing reading"></view>
  </view>
  <view class="register-form">

    <view class="title-container">
      <view class="title-head">更多照片</view>
      <view class="title-remark">展示你的多样魅力，更容易被喜欢</view>
    </view>
    
    <view class="picture-wall">
      <view class="picture-left">
        <view class="picture-main">

          <view class="picture-placeholder">
            <upload-file 
              remove-btn="{{true}}"
              class="upload-cover" 
              bind:change="onPictureChange"
              data-field="picture-smile"
            >
              <view slot="placeholder" class="placeholder-main">
                <image src="http://swik7nyin.hd-bkt.clouddn.com/icon_pic_main.png" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />
                <text>相册封面</text>
              </view>
            </upload-file>
          </view>
            
        </view>
        <view class="picture-bottom">
          <view class="picture-public">

          <view class="picture-placeholder">
            <upload-file 
              remove-btn="{{true}}"
              class="upload-cover" 
              bind:change="onPictureChange"
              data-field="picture-smile"
            >
              <view slot="placeholder" class="placeholder-main">
                <image src="http://swik7nyin.hd-bkt.clouddn.com/icon_pic_careful.png" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />
                <text>认真凹造型</text>
              </view>
            </upload-file>
          </view>



          </view>
          <view class="picture-public">

          <view class="picture-placeholder">
            <upload-file 
              remove-btn="{{true}}"
              class="upload-cover" 
              bind:change="onPictureChange"
              data-field="picture-smile"
            >
              <view slot="placeholder" class="placeholder-main">
                <image src="http://swik7nyin.hd-bkt.clouddn.com/icon_pic_confidence.png" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />
                <text>自信的才艺</text>
              </view>
            </upload-file>
          </view>



          </view>
        </view>
      </view>
      <view class="picture-right">
        <view class="picture-public">

          <view class="picture-placeholder">
            <upload-file 
              remove-btn="{{true}}"
              class="upload-cover" 
              bind:change="onPictureChange"
              data-field="picture-smile"
            >
              <view slot="placeholder" class="placeholder-main">
                <image src="http://swik7nyin.hd-bkt.clouddn.com/icon_pic_montain.png" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />
                <text>得意的旅行照</text>
              </view>
            </upload-file>
          </view>



        </view>
        <view class="picture-public">

          <view class="picture-placeholder">
            <upload-file 
              remove-btn="{{true}}"
              class="upload-cover" 
              bind:change="onPictureChange"
              data-field="picture-smile"
            >
              <view slot="placeholder" class="placeholder-main">
                <image src="http://swik7nyin.hd-bkt.clouddn.com/icon_pic_life.png" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />
                <text>生活中的样子</text>
              </view>
            </upload-file>
          </view>



        </view>
        <view class="picture-public">

          <view class="picture-placeholder">
            <upload-file 
              remove-btn="{{true}}"
              class="upload-cover" 
              bind:change="onPictureChange"
              data-field="picture-smile"
            >
              <view slot="placeholder" class="placeholder-main">
                <image src="http://swik7nyin.hd-bkt.clouddn.com/icon_pic_smile.png" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />  
                <text>笑起来的样子</text>
              </view>
            </upload-file>
          </view>
          
        </view>
      </view>
    </view>

  </view>

  <view class="form-reject">

    <view class="title-container">
      以下照片不能通过审核
    </view>

    <view class="reject-items">
      <view class="item">
        <image src="http://swik7nyin.hd-bkt.clouddn.com/reject_1.jpg" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />
        <text>他人照片</text>
        <view class="error"></view>
      </view>
      <view class="item">
        <image src="http://swik7nyin.hd-bkt.clouddn.com/reject_2.jpg" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />
        <view class="error"></view>
        <text>看不清脸</text>
      </view>
      <view class="item">
        <image src="http://swik7nyin.hd-bkt.clouddn.com/reject_3.jpg" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />
        <view class="error"></view>
        <text>P图过度</text>
      </view>
      <view class="item">
        <image src="http://swik7nyin.hd-bkt.clouddn.com/reject_4.jpg" mode="aspectFit|aspectFill|widthFix" lazy-load="false" />
        <view class="error"></view>
        <text>非人物照</text>
      </view>
    </view>
      
  </view>

  <view class="form-submit">下一步</view>
</view>



